# ══════════════════════════════════════════════════════════════
# SMARTSELLER — Variáveis de ambiente do backend
# ══════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Renomeie este arquivo de ".env.example" para ".env"
# 2. Preencha os campos marcados com <<< PREENCHER >>>
# 3. NUNCA commite o arquivo .env no Git (já está no .gitignore)
#
# ══════════════════════════════════════════════════════════════

# ── Supabase (banco de dados) ────────────────────────────────
# Projeto: smartseller · Região: US East
SUPABASE_URL=https://arnkmuxactmghhbgtzgm.supabase.co
SUPABASE_SERVICE_KEY=<<<COLE_AQUI_SB_SECRET_KEY>>>


# ── Servidor SMTP (seu servidor próprio) ─────────────────────
# Host do servidor SMTP — ex: mail.smartseller.com
SMTP_HOST=<<<SEU_HOST_SMTP>>>

# Porta — use 587 (TLS/STARTTLS, recomendado) ou 465 (SSL)
SMTP_PORT=587

# Usuário SMTP (geralmente o próprio e-mail do remetente)
SMTP_USER=<<<SEU_EMAIL_REMETENTE>>>

# Senha da conta de e-mail no servidor SMTP
SMTP_PASS=<<<SUA_SENHA_SMTP>>>

# Nome e e-mail que aparecerá como remetente no inbox
SMTP_FROM=SmartSeller <<<<SEU_EMAIL_REMETENTE>>>>

# ── Destino dos leads ─────────────────────────────────────────
# E-mail que vai receber todas as notificações de novos leads
EMAIL_TO=cpiccinini93@gmail.com

# ── Meta Conversions API ─────────────────────────────────────────
